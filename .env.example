# Vercel server environment (Upstash supplies the KV_* values automatically)
CVAR_INGEST_SECRET=replace-with-a-long-random-value
CVAR_ADMIN_PASSWORD=replace-with-a-separate-strong-password
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=replace-with-upstash-token
# Vercel Marketplace can use these prefixed names instead of the two KV_* names above.
CVAR_REDIS_KV_REST_API_URL=https://your-database.upstash.io
CVAR_REDIS_KV_REST_API_TOKEN=replace-with-upstash-token

# Control-room relay environment
ORBITS_HOST=127.0.0.1
ORBITS_PORT=50000
CVAR_INGEST_URL=https://your-project.vercel.app/api/ingest
CVAR_INGEST_KEY=use-the-same-value-as-CVAR_INGEST_SECRET
CVAR_EVENT_ID=mike-stephens-classic-2026
CVAR_EVENT_NAME=20th Annual Mike Stephens Classic
CVAR_TRACK_NAME=Hallett Motor Racing Circuit
CVAR_TRACK_LENGTH=1.8 mi · 10 turns
CVAR_SESSION_MODE=auto
CVAR_PUBLISH_INTERVAL_MS=10000
CVAR_RECORD_RAW=1
CVAR_RAW_ARCHIVE_DIR=recordings
